{
  "rewrites": [
    { "source": "/admin", "destination": "/backend/admin/index.html" },
    { "source": "/admin/", "destination": "/backend/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/backend/admin/:path*" },
